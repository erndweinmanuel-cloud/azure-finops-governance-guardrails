{
  "properties": {
    "displayName": "Audit missing governance tags in lab",
    "policyType": "Custom",
    "mode": "Indexed",
    "description": "Audits resources that are missing one or more required governance tags.",
    "metadata": {
      "category": "FinOps Guardrails",
      "version": "1.0.0"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the execution of the policy."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      }
    },
    "policyRule": {
      "if": {
        "anyOf": [
          {
            "field": "tags['Environment']",
            "exists": "false"
          },
          {
            "field": "tags['Project']",
            "exists": "false"
          },
          {
            "field": "tags['CostCenter']",
            "exists": "false"
          },
          {
            "field": "tags['Owner']",
            "exists": "false"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}