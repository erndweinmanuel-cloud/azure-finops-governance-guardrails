{
  "properties": {
    "displayName": "Allow only approved VM sizes in lab",
    "policyType": "Custom",
    "mode": "Indexed",
    "description": "Denies virtual machine deployments if the selected VM size is not part of the approved lab SKU list.",
    "metadata": {
      "category": "FinOps Guardrails",
      "version": "1.0.0"
    },
    "parameters": {
      "allowedVmSizes": {
        "type": "Array",
        "metadata": {
          "displayName": "Allowed VM sizes",
          "description": "The list of VM sizes that are allowed in the lab environment."
        },
        "defaultValue": [
          "Standard_B1s",
          "Standard_B2s"
        ]
      },
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the execution of the policy."
        },
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "defaultValue": "Deny"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Compute/virtualMachines"
          },
          {
            "field": "Microsoft.Compute/virtualMachines/sku.name",
            "notIn": "[parameters('allowedVmSizes')]"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}